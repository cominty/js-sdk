{
  "name": "@cominty/sdk",
  "version": "0.1.0",
  "description": "Official TypeScript client for the Cominty managed agent chat API",
  "license": "MIT",
  "author": "Cominty (https://cominty.ai)",
  "homepage": "https://github.com/cominty/js-sdk#readme",
  "bugs": {
    "url": "https://github.com/cominty/js-sdk/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cominty/js-sdk.git"
  },
  "keywords": [
    "cominty",
    "agents",
    "ai",
    "llm",
    "chat",
    "streaming",
    "sdk",
    "typescript"
  ],
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/test-utils.ts",
    "CHANGELOG.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "tsc -p tsconfig.json --noEmit",
    "lint": "biome ci .",
    "format": "biome check --write .",
    "prepublishOnly": "pnpm run check && pnpm run test && pnpm run build && pnpm run smoke",
    "smoke": "node scripts/smoke.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@11.24.0",
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/node": "^26.6.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
